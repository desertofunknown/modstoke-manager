{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "template": "windows/installer.nsi"
      },
      "wix": null
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "OpenACAI",
    "shortDescription": "Modstoke Manager by OpenACAI",
    "longDescription": "Independent mod manager for Sons of the Forest, by OpenACAI."
  },
  "productName": "Modstoke Manager",
  "mainBinaryName": "OpenACAI Mod Manager",
  "version": "../package.json",
  "identifier": "com.alexcooper.openacai.modmanager",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["modstoke"]
      }
    },
    "fs": {
      "scopeDroppedPaths": false
    },
    "http": {
      "scopeRedirects": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "center": true,
        "decorations": false,
        "fullscreen": false,
        "minHeight": 680,
        "minWidth": 980,
        "resizable": true,
        "shadow": false,
        "title": "Modstoke Manager by OpenACAI",
        "transparent": true,
        "visible": false,
        "width": 1280,
        "height": 820,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com wss://sso.nexusmods.com; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' https://gameskin.localhost; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  }
}
